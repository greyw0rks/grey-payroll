{
  "name": "greyfinance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch server/index.ts",
    "dev:sandbox": "tsx scripts/dev-sandbox.ts",
    "build": "tsx scripts/build.ts",
    "build:release": "tsx scripts/build-release.ts",
    "typecheck": "tsc --noEmit -p tsconfig.satfamily.json",
    "typecheck:all": "tsc --noEmit",
    "typecheck:academy": "tsc --noEmit -p tsconfig.satsacademy.json",
    "typecheck:sandbox": "tsc --noEmit -p tsconfig.sandbox.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test": "tsx scripts/test.ts",
    "test:greyfinance": "tsx --test tests/satfamily.test.ts",
    "test:academy": "tsx --test tests/academy.test.ts",
    "test:sandbox": "tsx --test tests/sandbox.test.ts tests/sandbox-bridge.test.ts",
    "test:convex": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx server/index.ts --production",
    "setup:bitcoin": "tsx scripts/setup-bitcoin.ts",
    "setup:sandbox": "tsx scripts/setup-sandbox.ts",
    "start:sandbox:runner": "tsx server/sandbox-runner.ts",
    "verify:sandbox": "tsx scripts/verify-sandbox.ts",
    "verify:sandbox:hosted": "tsx scripts/verify-sandbox-hosted.ts",
    "verify:sandbox:fresh": "node scripts/verify-sandbox-fresh.mjs",
    "preview:sandbox:hosted": "node scripts/start-sandbox-hosted.mjs",
    "preview:sandbox:watch": "node scripts/watch-sandbox-hosted.mjs",
    "verify:sandbox:browser": "node scripts/run-sandbox-verification.mjs browser",
    "verify:sandbox:fresh:background": "node scripts/run-sandbox-verification.mjs fresh",
    "verify:sandbox:recovery": "node scripts/verify-sandbox-runner-recovery.mjs",
    "verify:sandbox:recovery:background": "node scripts/run-sandbox-verification.mjs recovery",
    "setup:lightning": "tsx scripts/setup-lightning.ts",
    "verify:greyfinance": "tsx scripts/verify-satfamily.ts",
    "verify:greyfinance:hosted": "tsx scripts/verify-greyfinance-hosted.ts",
    "verify:academy:hosted": "tsx scripts/verify-academy-hosted.ts",
    "verify:academy:ui": "tsx scripts/verify-academy-ui.ts",
    "preview:academy": "node scripts/start-academy-preview.mjs",
    "check:release": "node scripts/check-release.mjs",
    "demo:bitcoin": "tsx scripts/bitcoin-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@getalby/sdk": "^7.0.0",
    "@noble/hashes": "^2.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "convex": "^1.49.0",
    "express": "^5.1.0",
    "light-bolt11-decoder": "^3.2.0",
    "nostr-tools": "^2.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "convex-test": "^0.0.71",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
