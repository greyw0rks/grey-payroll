# Vercel production environment for apps/web. Copy values into Vercel; do not commit secrets.
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/register

# Mainnet-first UX. Arc Testnet remains selectable for rehearsals.
NEXT_PUBLIC_ARC_DEFAULT_CHAIN_ID=5042
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_PAYROLL_RUNTIME_HASH=0xb219b4c8f0374fef7421d4cebb32c81dbd6dbbf44869d7569dad4209f8eeae9d

# Optional integrations. Leave unset unless the feature is enabled.
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_MODEL=claude-sonnet-4-6
REDIS_URL=
EMAIL_API_KEY=
EMAIL_FROM=noreply@grey.finance

# Standalone arc-module production build. The embedded company build maps the
# NEXT_PUBLIC values above into these Vite values automatically.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_ARC_DEFAULT_CHAIN_ID=5042
