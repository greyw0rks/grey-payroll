FROM node:22.23.4-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@12.16.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build -- bitcoin-sandbox && mkdir -p /app/.data /app/.tools && chown -R node:node /app
USER node
ENV SATS_DATA_DIR=/app/.data/sandbox BITCOIN_RPC_PORT=18444 BITCOIN_ZMQ=0 SANDBOX_API_PORT=4415 SANDBOX_API_HOST=0.0.0.0 SATS_DEMO=0
EXPOSE 4415
CMD ["sh", "-c", "pnpm setup:sandbox && pnpm exec tsx server/sandbox-local.ts"]
