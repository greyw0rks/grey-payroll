{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build:release",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/academy",
      "destination": "https://satsacademy.vercel.app/",
      "permanent": true
    },
    {
      "source": "/academy/",
      "destination": "https://satsacademy.vercel.app/",
      "permanent": true
    },
    {
      "source": "/academy/:path*",
      "destination": "https://satsacademy.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/satsacademy",
      "destination": "https://satsacademy.vercel.app/",
      "permanent": true
    },
    {
      "source": "/satsacademy/",
      "destination": "https://satsacademy.vercel.app/",
      "permanent": true
    },
    {
      "source": "/satsacademy/:path*",
      "destination": "https://satsacademy.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/sandbox",
      "destination": "https://bitcoin-sandbox.vercel.app/",
      "permanent": true
    },
    {
      "source": "/sandbox/",
      "destination": "https://bitcoin-sandbox.vercel.app/",
      "permanent": true
    },
    {
      "source": "/sandbox/:path*",
      "destination": "https://bitcoin-sandbox.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/nostrchat",
      "destination": "https://nostrchat-greyw0rks.vercel.app/",
      "permanent": true
    },
    {
      "source": "/nostrchat/",
      "destination": "https://nostrchat-greyw0rks.vercel.app/",
      "permanent": true
    },
    {
      "source": "/nostrchat/:path*",
      "destination": "https://nostrchat-greyw0rks.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://intent-curlew-185.convex.site/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
