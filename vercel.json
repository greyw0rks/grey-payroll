{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build:release",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/satsacademy", "destination": "/academy", "permanent": true },
    { "source": "/satsacademy/:path*", "destination": "/academy/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://intent-curlew-185.convex.site/api/:path*" },
    { "source": "/academy", "destination": "/academy/index.html" },
    { "source": "/academy/((?!assets/|brand/|favicon.svg).*)", "destination": "/academy/index.html" },
    { "source": "/((?!api/|academy/|assets/|favicon.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/academy/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
