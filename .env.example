# Local practice runs on loopback. No live credentials are needed for ./start.sh.
SATS_DEMO_MODE=1
SATS_MAX_PAYMENT_SATS=1000000

# For a local server using a real wallet, set SATS_DEMO_MODE=0.
# Delegate only the required NWC capabilities and a provider-enforced budget.
# SATS_APP_ORIGIN=https://your-app.example
# SATS_NWC_RELAY_ALLOWLIST=relay.getalby.com,relay.nwc.lol

# Set the following in Convex environment settings, never in browser variables:
# GREY_APP_ORIGIN=https://grey-finance.vercel.app
# GREY_WALLET_ENCRYPTION_KEY=<32 random bytes encoded as 64 hexadecimal characters>
# GREY_MAX_PAYMENT_SATS=1000000
# GREY_NWC_RELAY_ALLOWLIST=relay.getalby.com,relay.nwc.lol,nostr.bitcoiner.social,relay.damus.io,relay.primal.net

# GREY_REGTEST_RELAY_HOST is only for a temporary relay-only regtest acceptance test.
# Keep it unset for normal operation. No wallet seeds or NWC secrets belong here.
