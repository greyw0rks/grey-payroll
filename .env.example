# Database
DATABASE_URL="postgresql://user:password@localhost:5432/grey"

# Auth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Blockchain
CELO_RPC_URL="https://forno.celo.org"
CELO_TESTNET_RPC_URL="https://alfajores-forno.celo-testnet.org"
BASE_RPC_URL="https://mainnet.base.org"
SIGNER_PRIVATE_KEY=""  # Backend relayer wallet — use HSM in prod, never commit this

# Contract Addresses (Alfajores testnet)
PAYROLL_TREASURY_ADDRESS=""
EMPLOYEE_REGISTRY_ADDRESS=""
REFUND_VAULT_ADDRESS=""
SALARY_ADVANCE_ADDRESS=""

# IPFS / Pinata
PINATA_API_KEY=""
PINATA_SECRET_KEY=""
PINATA_GATEWAY="https://gateway.pinata.cloud"

# AI provider — "anthropic" (default) or "watsonx"
AI_PROVIDER="anthropic"

# AI: Anthropic-compatible (Claude direct, or any gateway via base URL)
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""          # optional; omit to hit Anthropic directly
AI_MODEL="claude-sonnet-4-6"

# AI: IBM watsonx.ai (Granite) — used when AI_PROVIDER=watsonx
WATSONX_API_KEY=""             # IBM Cloud API key
WATSONX_PROJECT_ID=""          # watsonx.ai project id
WATSONX_URL="https://us-south.ml.cloud.ibm.com"
WATSONX_MODEL="ibm/granite-3-8b-instruct"


# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# Email (Resend)
EMAIL_API_KEY=""
EMAIL_FROM="noreply@grey.finance"

# Price Oracle
COINGECKO_API_KEY=""

# Privy (embedded wallets)
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# Environment
NODE_ENV="development"
NEXT_PUBLIC_CHAIN_ID="44787"  # Alfajores testnet; 42220 for mainnet
